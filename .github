name: Build Mizan APK Direct

on:
  push:
    branches: [ main, master ]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install System Dependencies
        run: |
          sudo apt update
          sudo apt install -y openjdk-17-jdk git zip unzip build-essential python3-dev libltdl-dev libffi-dev libssl-dev

      - name: Install Buildozer and Cython
        run: |
          python -m pip install --upgrade pip
          pip install --user --upgrade cython==0.29.36 buildozer

      - name: Add Python local bin to PATH
        run: echo "$HOME/.local/bin" >> $GITHUB_PATH

      - name: Run Buildozer Android Debug
        run: buildozer -v android debug

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: mizan-altamam-apk
          path: bin/*.apk
